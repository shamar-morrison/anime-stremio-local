{
  "name": "anime-stremio-local",
  "version": "1.2.0",
  "description": "Local, self-hosted Stremio addon that finds anime torrents (Subbed and Dubbed) from Anime Garden, Nyaa and Tokyo Toshokan.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@stremio-addon/node": "^1.0.0",
    "@stremio-addon/sdk": "^1.1.0",
    "fast-xml-parser": "^5.11.2",
    "nyaa-sia": "3.0.0",
    "tsx": "^4.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
